+async def test_build_creates_a_kinescope_activity(db, org, admin_user, redis_store):
+    spec = {
+        "idempotency_key": "build-test-kinescope",
+        "course": {"name": "Talks", "description": "Recorded talks."},
+        "chapters": [{"key": "c1", "name": "Talks", "activities": [
+            {"key": "keynote", "kind": "kinescope", "name": "Keynote", "url": "https://kinescope.io/203613411"},
+        ]}],
+    }
+    plan = (await build(db, org, admin_user, {**spec, "dry_run": True})).result
+    assert "kinescope" in [s["what"] for s in plan["steps"]]
+    with patch("src.services.ai.tools.courses._set_thumbnail", new=AsyncMock()):
+        out = await build(db, org, admin_user, spec)
+    assert out.status == "executed", out.reason
+    row = (await db.execute(select(Activity).where(Activity.name == "Keynote"))).scalars().one()
+    assert row.content["uri"] == "https://kinescope.io/203613411" and row.content["type"] == "kinescope"
+
