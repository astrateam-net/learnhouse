+def _kinescope_id(url: str) -> str | None:
+    """The video id of a Kinescope share or embed link (kinescope.io/<id>, /embed/<id>), else None."""
+    parts = urlsplit(url.strip())
+    host = (parts.hostname or "").lower().removeprefix("www.")
+    if parts.scheme not in ("http", "https") or host != "kinescope.io":
+        return None
+    path = [p for p in parts.path.split("/") if p]
+    if path[:1] == ["embed"]:
+        path = path[1:]
+    return path[0] if len(path) == 1 and path[0].isalnum() and len(path[0]) <= 40 else None
+
+
