{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>astrateam-net/renovate-config'],

  // Moving the pin means restacking the series; a bot that only moves the
  // pointer leaves the patch unapplied.
  'git-submodules': {
    enabled: false,
  },

  // .github/dependabot.yaml already owns these.
  'github-actions': {
    enabled: false,
  },

  packageRules: [
    {
      // Upstream dictates them: the Dockerfile's bun, uv and node stages and
      // api-lint's ruff pin. A different toolchain diverges from upstream's build.
      matchManagers: ['mise'],
      matchDepNames: ['bun', 'uv', 'node', 'python', 'ruff'],
      enabled: false,
    },
  ],
}
